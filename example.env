# Шаблон окружения. Реальные значения НЕ коммитить — держать в .env (в .gitignore).

# --- Cloud.ru Evolution ML Inference (LLM атакующего агента) ---
# IAM-ключ сервисного аккаунта стенда (key_id / secret). Секреты — только здесь/в .env.
EVOLUTION_KEY_ID=
EVOLUTION_SECRET=
# Публичный URL деплоя модели + /v1, напр. https://<uuid>.modelrun.inference.cloud.ru/v1
EVOLUTION_BASE_URL=
# Имя обслуживаемой модели на деплое (для дедицированного деплоя обычно "default").
EVOLUTION_MODEL=default
# Необязательно: endpoint выдачи IAM-токена (по умолчанию библиотеки).
EVOLUTION_TOKEN_URL=https://iam.api.cloud.ru/api/v1/auth/token
# Строгий JSON-режим (response_format=json_object). Включать, только если деплой поддерживает.
EVOLUTION_JSON_MODE=0
